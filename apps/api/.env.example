# ── PulseBoard API ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database: leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite).
# For production use a real PostgreSQL instance:
# DATABASE_URL=postgresql://pulseboard:pulseboard@localhost:5432/pulseboard
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-please-change-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=false

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Email (optional — without SMTP the app logs emails in dev mode)
MAIL_FROM="PulseBoard <no-reply@pulseboard.app>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMTP_SECURE=false
