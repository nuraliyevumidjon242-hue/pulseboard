{
  "name": "@pulseboard/api",
  "version": "1.0.0",
  "private": true,
  "description": "PulseBoard REST + WebSocket API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "bcryptjs": "2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.4",
    "express": "^4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "0.15.2",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "pino-http": "10.3.0",
    "socket.io": "4.8.1",
    "swagger-ui-express": "5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "22.10.5",
    "@types/pdfkit": "0.13.9",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.8",
    "drizzle-kit": "0.31.1",
    "eslint": "^9.39.5",
    "pino-pretty": "13.0.0",
    "supertest": "7.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vitest": "^4.1.12"
  }
}
