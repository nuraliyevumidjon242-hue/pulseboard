# ── PulseBoard Docker Compose ───────────────────────────────────────────
# Copy to .env (or run `npm run docker:env`) and replace every CHANGE_ME.
# The API refuses to boot in production while placeholder secrets remain.
APP_URL=http://localhost:8080
WEB_PORT=8080

POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET

# Keep false for plain-HTTP localhost. Set true when served over HTTPS.
COOKIE_SECURE=false
LOG_LEVEL=info

# Optional email delivery. Without SMTP, messages are logged by the API.
MAIL_FROM=PulseBoard <no-reply@pulseboard.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
